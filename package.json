{
  "name": "ecsx",
  "description": "Easily create, manage and deploy ECS based applications",
  "version": "0.9.2",
  "author": "Marc Qualie @marcqualie",
  "bin": {
    "ecsx": "./bin/run"
  },
  "bugs": "https://github.com/marcqualie/ecsx/issues",
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1052.0",
    "@inquirer/prompts": "^8.7.4",
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "@oclif/plugin-plugins": "^5.5.2",
    "dayjs": "^1.11.23",
    "jsonschema": "^1.5.0",
    "tslib": "^2.8.1",
    "tty-table": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@oclif/test": "^4.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@typescript/native": "npm:typescript@7.0.2",
    "jest": "^30.5.2",
    "oclif": "^4.24.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/marcqualie/ecsx",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "ecsx",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "packageManager": "pnpm@11.5.1",
  "repository": "marcqualie/ecsx",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "clean": "tsc --build --clean",
    "dev": "./bin/dev",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "pnpm lint",
    "prepack": "tsc -b --clean && tsc -b && oclif manifest && oclif readme",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "version": "oclif readme && git add README.md"
  },
  "types": "lib/index.d.ts"
}
